#!/bin/sh
# 욱채 서버 운영자 명령 (Linux) — node out/server/index.mjs <명령>과 같다. scripts/wook-server.cmd의 Linux 짝 (리드 결정 S10-6.8)
# 이 파일의 실제 자리(링크를 푼 것)에서 ../out/server/index.mjs를 PATH의 node(24 이상)로 띄운다. 먼저 npm run build:server
here=$(dirname -- "$(readlink -f -- "$0")")
exec node "$here/../out/server/index.mjs" "$@"
