{
  "name": "wookagent",
  "productName": "욱채",
  "version": "0.1.0",
  "private": true,
  "description": "욱채 프로그램 — 대표의 명령을 AI 팀(Claude·Codex)이 수행하는 AI 스튜디오 운영 PC 프로그램",
  "main": "./out/main/index.js",
  "author": "wook",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "build:web": "vite build --config vite.web.config.ts --mode remote",
    "start": "electron-vite preview",
    "start:server": "node out/server/index.mjs",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:web": "vitest run --config vitest.web.config.ts",
    "jobrunner:build": "node scripts/build-jobrunner.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/keyring": "2.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "diff": "9.0.0",
    "dompurify": "3.4.17",
    "electron": "45.0.0",
    "electron-vite": "6.0.0",
    "lucide-react": "1.62.0",
    "marked": "18.1.2",
    "playwright-core": "1.64.1",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
